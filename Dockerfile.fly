# syntax=docker/dockerfile:1.7
#
# Fly-specific: official OpenClaw CI image + gbrain + Fly start wrapper.
# The monorepo build OOMs Fly remote builders (tsdown needs ~8GB), so this
# pulls the published image and layers the deployment additions on top.
# To upgrade OpenClaw: bump OPENCLAW_IMAGE to a newer tag and digest, then deploy.
# (codex CLI lives on the /data volume at /data/bin, untouched by deploys.)

ARG OPENCLAW_IMAGE="ghcr.io/openclaw/openclaw:2026.6.6-beta.1@sha256:084895f8ce6dc19df940416e378234f0e00fbd2ffd806d345b7654050b711b8a"
ARG OPENCLAW_BUN_IMAGE="docker.io/oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e"
ARG OPENCLAW_NODE_IMAGE="docker.io/library/node:24-bookworm@sha256:d5adb040f90e206d1dc91453d08a4fa4165ec0faebd62a3421e6181a14e7f41f"
ARG GBRAIN_GIT_REF="65ff663f7df4de7bf379133f346a280a970f05e1"

FROM ${OPENCLAW_BUN_IMAGE} AS bun-binary

FROM ${OPENCLAW_NODE_IMAGE} AS gbrain-build
ARG GBRAIN_GIT_REF
COPY --from=bun-binary /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /tmp/gbrain
RUN git clone https://github.com/garrytan/gbrain.git . && \
    git checkout --detach "$GBRAIN_GIT_REF" && \
    bun install --frozen-lockfile

FROM ${OPENCLAW_IMAGE}
USER root
COPY --from=bun-binary /usr/local/bin/bun /usr/local/bin/bun
COPY --from=gbrain-build --chown=node:node /tmp/gbrain /opt/gbrain
RUN printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/bun /opt/gbrain/src/cli.ts "$@"' > /usr/local/bin/gbrain && \
    chmod 755 /usr/local/bin/gbrain
COPY --chown=root:root scripts/fly-start.sh /usr/local/bin/openclaw-fly-start
RUN chmod 755 /usr/local/bin/openclaw-fly-start

# The deployment config overrides this to root so openclaw-fly-start
# can repair /data ownership before dropping privileges to node.
ARG OPENCLAW_RUNTIME_USER=node
USER ${OPENCLAW_RUNTIME_USER}
